# Copy to .dev.vars (gitignored) and fill in. Never commit the real file.
#
# From Meta dashboard → your app → WhatsApp → API Setup:
WHATSAPP_TOKEN=EAAG...            # temporary 24h token is fine for testing
PHONE_NUMBER_ID=123456789012345   # the test number's ID, not the phone number

# From Meta dashboard → your app → App Settings → Basic → App Secret:
APP_SECRET=abc123...

# Any string you invent. Type the same one into the webhook config form.
VERIFY_TOKEN=kunang-dev-2026

# Optional. If set, Kunang must send it as X-Relay-Secret on /messages.
# Leave blank while testing — the app does not send this header today.
APP_SHARED_SECRET=

# Set to "off" to stop writing the [Intake] summary line into the Kunang
# thread. Default is on — without it, the intake answers are invisible in the
# app and you'd have to read GET /queue instead.
INTAKE_SUMMARY=on
